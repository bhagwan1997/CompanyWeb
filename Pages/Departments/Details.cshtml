@page
@model CompanyWeb.Pages.Departments.DetailsModel

<h1>Department Details</h1>

<dl class="row">
    <dt class="col-sm-2">Department ID</dt>
    <dd class="col-sm-10">@Model.Department.DepartmentId</dd>

    <dt class="col-sm-2">Department Name</dt>
    <dd class="col-sm-10">@Model.Department.DepartmentName</dd>
</dl>

<p>
    <a asp-page="./Edit" asp-route-id="@Model.Department.DepartmentId" class="btn btn-primary">Edit</a>
    <a asp-page="./Index" class="btn btn-secondary">Back</a>
</p>
