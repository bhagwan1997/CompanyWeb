@page
@model CompanyWeb.Pages.Departments.DeleteModel

<h1>Delete Department</h1>

<h3>Are you sure you want to delete this?</h3>

<dl class="row">
    <dt class="col-sm-2">Department ID</dt>
    <dd class="col-sm-10">@Model.Department.DepartmentId</dd>

    <dt class="col-sm-2">Department Name</dt>
    <dd class="col-sm-10">@Model.Department.DepartmentName</dd>
</dl>

<form method="post">
    <input type="hidden" asp-for="Department.DepartmentId" />
    <input type="submit" value="Delete" class="btn btn-danger" />
    <a asp-page="./Index" class="btn btn-secondary">Cancel</a>
</form>
