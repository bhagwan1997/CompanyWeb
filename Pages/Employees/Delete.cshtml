@page
@model CompanyWeb.Pages.Employees.DeleteModel

<h1>Delete Employee</h1>

<h3>Are you sure you want to delete this?</h3>

<dl class="row">
    <dt class="col-sm-2">Employee ID</dt>
    <dd class="col-sm-10">@Model.Employee.EmployeeId</dd>

    <dt class="col-sm-2">First Name</dt>
    <dd class="col-sm-10">@Model.Employee.FirstName</dd>

    <dt class="col-sm-2">Last Name</dt>
    <dd class="col-sm-10">@Model.Employee.LastName</dd>

    <dt class="col-sm-2">Department</dt>
    <dd class="col-sm-10">@Model.Employee.Department?.DepartmentName</dd>
</dl>

<form method="post">
    <input type="hidden" asp-for="Employee.EmployeeId" />
    <input type="submit" value="Delete" class="btn btn-danger" />
    <a asp-page="./Index" class="btn btn-secondary">Cancel</a>
</form>
