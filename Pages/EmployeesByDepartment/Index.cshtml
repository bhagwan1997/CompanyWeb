@page
@model CompanyWeb.Pages.EmployeesByDepartment.IndexModel

<h1>Employees By Department</h1>

<table class="table">
    <thead>
        <tr>
            <th>Department ID</th>
            <th>Department</th>
            <th>Employee ID</th>
            <th>Employee Name</th>
        </tr>
    </thead>
    <tbody>
@foreach (var r in Model.Rows)
{
        <tr>
            <td>@r.DepartmentId</td>
            <td>@r.DepartmentName</td>
            <td>@r.EmployeeId</td>
            <td>@r.EmployeeName</td>
        </tr>
}
    </tbody>
</table>
